# URL de conexão do PostgreSQL no Supabase
# Substitua pela sua URL real no arquivo .env
DATABASE_URL=postgresql://postgres.SUO_PROJETO_REF:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave secreta para assinar os tokens JWT de login
SECRET_KEY=sua_chave_jwt_secreta_super_segura_aqui_minimo_32_caracteres

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Tempo de expiração do Token JWT em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Chave Fernet (AES-256) em Base64 para criptografia simétrica das senhas no cofre
# Você pode gerar uma no terminal Python com: cryptography.fernet.Fernet.generate_key().decode()
FERNET_KEY=sua_chave_fernet_32_bytes_base64_aqui